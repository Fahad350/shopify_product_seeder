# Copy to .env and adjust for your machine. Never commit .env.
#
# Shopify credentials (shop domain, client ID, client secret) are NOT set here:
# enter them on the app's Settings page, where the secret is stored encrypted.

# Shopify Admin API version (current stable release)
SHOPIFY_API_VERSION=2026-10

# Local PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
