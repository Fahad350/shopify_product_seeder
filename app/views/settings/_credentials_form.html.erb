<section class="card">
  <%= form_with model: setting, url: settings_path, method: :patch do |f| %>
    <div class="card-head"><h2>Store credentials</h2></div>
    <div class="card-body">
      <% if setting.errors.any? %>
        <div class="flash flash-alert flash-inline">
          <ul>
            <% setting.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="field">
        <%= f.label :shop_domain, "Shop domain" %>
        <%= f.text_field :shop_domain, placeholder: "your-store.myshopify.com", autocomplete: "off", spellcheck: false %>
        <div class="hint">The store's .myshopify.com domain.</div>
      </div>

      <div class="field">
        <%= f.label :client_id, "Client ID" %>
        <%= f.text_field :client_id, autocomplete: "off", spellcheck: false %>
      </div>

      <div class="field">
        <%= f.label :client_secret, "Client secret" %>
        <%# The stored secret is never rendered back into the page. %>
        <%= f.password_field :client_secret, value: nil, autocomplete: "new-password",
              placeholder: (setting.persisted? ? "••••••••••••" : "") %>
        <div class="hint">
          <%= setting.persisted? ? "Stored encrypted. Leave blank to keep the current secret." : "Stored encrypted at rest." %>
        </div>
      </div>
    </div>
    <div class="card-foot">
      <%= f.submit "Save Settings", class: "btn", data: { turbo_submits_with: "Saving…" } %>
    </div>
  <% end %>
</section>
