<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Shopify Product Seeder" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Shopify Product Seeder">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% setting = ShopSetting.current %>
    <header class="topbar">
      <div class="topbar-inner">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand-mark">S</span> Product Seeder
        <% end %>
        <nav class="tabs">
          <%= link_to "Dashboard", product_seeds_path, class: ["tab", ("active" if controller_name == "product_seeds")] %>
          <%= link_to "Settings", edit_settings_path, class: ["tab", ("active" if controller_name == "settings")] %>
        </nav>
        <% if setting.persisted? %>
          <span class="store-pill" title="<%= setting.connected? ? "Connected" : "Not connected" %>">
            <span class="dot <%= setting.connected? ? "dot-ok" : (setting.connection_status == "failed" ? "dot-err" : "") %>"></span>
            <%= setting.shop_domain %>
          </span>
        <% end %>
      </div>
    </header>

    <main>
      <% flash.each do |type, msg| %>
        <div class="flash flash-<%= type %>" role="status"
             data-controller="flash" data-flash-delay-value="<%= type == "alert" ? 8000 : 5000 %>">
          <span><%= msg %></span>
          <button type="button" class="flash-close" aria-label="Dismiss" data-action="flash#dismiss">&times;</button>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
