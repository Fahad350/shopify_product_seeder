<% content_for :title, "Dashboard · Product Seeder" %>
<%= render "shared/page_header", title: "Dashboard", subtitle: "Import products from DummyJSON into your Shopify store." %>

<%= render "seed_panel", setting: @setting %>

<% if @run %>
  <div class="stats">
    <% { created: "Created", updated: "Updated", skipped: "Skipped", failed: "Failed" }.each do |key, label| %>
      <%= render "stat_card", key: key, label: label, count: @run.public_send("#{key}_count") %>
    <% end %>
  </div>

  <%# Only this frame reloads while new product images are still processing in Shopify. %>
  <%= turbo_frame_tag "last_run", data: { controller: "thumb-refresh", thumb_refresh_url_value: product_seeds_path } do %>
    <%= render "last_run", run: @run, results: @results, setting: @setting, live_products: @live_products %>
  <% end %>
<% else %>
  <section class="card">
    <div class="empty">
      <strong>No imports yet</strong>
      Click <em>Seed Store</em> to import your first products.
    </div>
  </section>
<% end %>
