<%# live_products is nil when Shopify could not be checked: then the stored image is used. %>
<% shopify_id = result["shopify_id"] %>
<% exists = live_products && shopify_id.present? && live_products.key?(shopify_id) %>
<% pending = exists && live_products[shopify_id].blank? # image still processing in Shopify %>
<% image_url = pending ? nil : (live_products&.dig(shopify_id).presence || result["image_url"]) %>
<tr>
  <td>
    <div class="product">
      <% if image_url.present? %>
        <img class="thumb" src="<%= image_url %>" alt="" loading="lazy" onerror="this.removeAttribute('src')">
      <% elsif pending %>
        <span class="thumb thumb-pending" title="Image processing in Shopify"></span>
      <% else %>
        <span class="thumb"></span>
      <% end %>
      <span class="product-title"><%= result["title"] %></span>
    </div>
  </td>
  <td class="mono">#<%= result["source_id"] %></td>
  <td><span class="badge outcome-<%= result["outcome"] %>"><%= result["outcome"].humanize %></span></td>
  <td>
    <% Array(result["messages"]).each do |m| %>
      <div class="msg <%= "msg-error" if result["outcome"] == "failed" %>"><%= m %></div>
    <% end %>
    <% if shopify_id.present? %>
      <%= link_to "View in Shopify ↗", shopify_admin_product_url(setting, shopify_id),
            target: "_blank", rel: "noopener", class: "shopify-link" %>
    <% end %>
  </td>
</tr>
